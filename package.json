{
  "name": "nexo-workspace",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "node --test --test-concurrency=1 server/tests/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:reset": "node server/reset.js",
    "bundle:report": "node scripts/bundle-report.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.0",
    "styled-components": "^6.1.19",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
